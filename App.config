<?xml version="1.0" encoding="utf-8" ?>

<!--
========================================================
Example 11 - App.config Trace Configuration
========================================================

This is an example of the configuration style used by
older .NET Framework applications.

When compiled in .NET Framework, App.config could become:

YourApplication.exe.config

This project uses modern .NET 10, so this file is included
for learning purposes rather than as the active logging
configuration.
========================================================
-->

<configuration>

	<system.diagnostics>

		<trace autoflush="true">

			<listeners>

				<add
				  name="fileListener"
				  type="System.Diagnostics.TextWriterTraceListener"
				  initializeData="trace-output.log" />

				<remove name="Default" />

			</listeners>

		</trace>

	</system.diagnostics>

</configuration>